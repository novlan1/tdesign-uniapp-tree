{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^tdesign-uniapp-tree$": "@/components/tdesign-uniapp-tree/tdesign-uniapp-tree.vue",
      "^t-(.*)": "@tdesign/uniapp/$1/$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "Tree 树形选择"
      }
    },
    {
      "path": "pages/tree-page/index",
      "style": {
        "navigationBarTitleText": "页面模式"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "tdesign-uniapp-tree",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  }
}
