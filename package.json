{
  "name": "tdesign-uniapp-tree",
  "version": "0.0.3",
  "description": "tdesign-uniapp-tree 树形选择器组件 - 基于 Vue3 + uni-app，支持多选/单选/搜索/懒加载",
  "author": "",
  "license": "MIT",
  "keywords": [
    "tree",
    "tree-select",
    "uniapp",
    "vue3",
    "miniprogram",
    "tdesign-uniapp-tree",
    "tdesign"
  ],
  "files": [
    "dist",
    "global.d.ts",
    "LICENSE",
    "README.md",
    "changelog.md"
  ],
  "typings": "./dist/types/index.d.ts",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": "./dist/*",
    "./global": {
      "types": "./global.d.ts"
    },
    "./tdesign-uniapp-tree/tdesign-uniapp-tree.vue": {
      "types": "./dist/types/tdesign-uniapp-tree.d.ts",
      "import": "./dist/tdesign-uniapp-tree/tdesign-uniapp-tree.vue",
      "default": "./dist/tdesign-uniapp-tree/tdesign-uniapp-tree.vue"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev:h5": "uni",
    "build:h5": "uni build",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "dev:app": "uni -p app",
    "build:app": "uni build -p app",
    "release:prepare": "node ./scripts/release-prepare.js",
    "build:npm": "npm run release:prepare",
    "prepublishOnly": "npm run build:npm",
    "copy:starter": "node ./scripts/copy-to-starter.js"
  },
  "dependencies": {
    "@tdesign/uniapp": "^0.8.0"
  },
  "devDependencies": {
    "@dcloudio/uni-app": "3.0.0-4060620250520001",
    "@dcloudio/uni-app-plus": "3.0.0-4060620250520001",
    "@dcloudio/uni-components": "3.0.0-4060620250520001",
    "@dcloudio/uni-h5": "3.0.0-4060620250520001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4060620250520001",
    "@dcloudio/types": "^3.4.14",
    "@dcloudio/uni-automator": "3.0.0-4060620250520001",
    "@dcloudio/uni-cli-shared": "3.0.0-4060620250520001",
    "@dcloudio/uni-stacktracey": "3.0.0-4060620250520001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4060620250520001",
    "vue": "^3.4.38",
    "less": "^4.2.0",
    "typescript": "^5.3.3",
    "vite": "^5.4.14"
  },
  "peerDependencies": {
    "@tdesign/uniapp": ">=0.7.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "@tdesign/uniapp": {
      "optional": false
    }
  }
}
